{
  "functions": { "api/game.js": { "maxDuration": 15 }, "api/recover.js": { "maxDuration": 30 } },
  "crons": [{ "path": "/api/recover", "schedule": "0 12 * * *" }],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }
  ]
}
